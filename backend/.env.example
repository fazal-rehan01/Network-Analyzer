# Copy to .env and adjust as needed. Never commit .env.

# Database: SQLite for local dev, or PostgreSQL for deployment
# SQLite:
DATABASE_URL=sqlite:///./traffic.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/traffic

# Storage root (uploads, pcaps, reports, zeek logs)
STORAGE_DIR=storage

# Directories (relative to STORAGE_DIR)
UPLOAD_DIR=uploads
PCAP_DIR=pcaps
REPORT_DIR=reports
ZEEK_DIR=zeek

# Upload limits
MAX_UPLOAD_MB=100

# Tool paths (leave empty for auto-detect)
TSHARK_PATH=
ZEEK_PATH=

# Safe default simulation targets
SIM_TARGET_LOCALHOST=127.0.0.1
SIM_TARGET_PRIVATE=192.168.10.10

# CORS origins for the frontend dev server
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Detection engine thresholds (M10)
# Minimum distinct TCP dst ports from one source to flag a scan
DETECT_PORTSCAN_MIN_PORTS=10
# Connection-rate: sliding window (seconds) and max connections allowed in it
DETECT_CONN_RATE_WINDOW_SEC=10
DETECT_CONN_RATE_MAX_PER_WINDOW=100
# DNS anomaly: minimum NXDOMAIN responses to flag
DETECT_DNS_NXDOMAIN_MIN=5
# DNS diversity: minimum unique queries from one source to flag
DETECT_DNS_QUERY_DIVERSITY_MIN=50
# Severity scaling: ratio of observed/threshold that escalates severity
DETECT_SEVERITY_HIGH_MULTIPLIER=2.0
DETECT_SEVERITY_CRITICAL_MULTIPLIER=4.0
